# ─────────────────────────────────────────────────────────────
# Tafaqqah | تفقّه — environment variables
#   cp .env.example .env      then edit. Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# ══════════════ REQUIRED ══════════════

# Docker Compose: password of the bundled PostgreSQL (choose any value; it never leaves your machine).
POSTGRES_PASSWORD="change-me-local-only"

# Local development without Docker only: connection string of your own PostgreSQL.
# (Docker Compose builds its own DATABASE_URL from the POSTGRES_* values and ignores this one.)
DATABASE_URL="postgresql://tafaqqah:change-me-local-only@localhost:5432/tafaqqah"

# ══════════════ AI (strongly recommended) ══════════════
# gemini | anthropic | mock
#   gemini    — requires GEMINI_API_KEY
#   anthropic — requires ANTHROPIC_API_KEY
#   mock      — DEVELOPMENT ONLY deterministic provider; refused when NODE_ENV=production (i.e. in Docker)
# Without a working key the app still runs: the understanding test uses the human-approved question bank, AI
# follow-up questions and targeted re-checks are skipped (never faked), and memorization reinforcement uses its
# deterministic fallback exercises. No question, explanation or exercise is generated without a key.
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL=""            # optional, default gemini-3.5-flash-lite
ANTHROPIC_API_KEY=""

# ══════════════ OPTIONAL ══════════════

# Docker Compose
APP_PORT="3000"            # host port of the app (http://localhost:APP_PORT)
POSTGRES_USER="tafaqqah"
POSTGRES_DB="tafaqqah"

# Admin bootstrap: on the FIRST start of an empty database (Docker) or on `npm run db:seed`,
# creates this admin account (or promotes an existing user). Password: at least 12 characters.
# Leave empty to skip; you can later run `npm run admin:promote -- <email>`.
# For a public/judging deployment: use a dedicated account and a NEW password used nowhere else
# (see docs/DEPLOYMENT.md §3). Set it in the host's environment, never in a committed file.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Assessment mode: adaptive | fixed | split
#   adaptive — every learner gets the AI adaptive assessment
#   fixed    — every learner gets the predefined fixed question bank
#   split    — new learners are alternately assigned to ADAPTIVE / FIXED groups
ASSESSMENT_MODE_STRATEGY="adaptive"

# Model / effort overrides for the anthropic provider (defaults: claude-opus-5-5)
# AI_GENERATOR_MODEL="claude-opus-5-5"
# AI_VALIDATOR_MODEL="claude-opus-5-5"
# AI_GENERATOR_EFFORT="medium"     # low | medium | high | xhigh | max
# AI_VALIDATOR_EFFORT="high"

# Max question-generation requests per learner per 10 minutes
# AI_RATE_LIMIT_PER_10_MIN="40"

# Memorization reinforcement EVALUATION ONLY: comma-separated learner ids that get the non-AI BASELINE_REVIEW.
# Leave empty — every other learner always gets the AI adaptive coach. Never selectable by learners.
REINFORCEMENT_BASELINE_USER_IDS=""

# ══════════════ DEVELOPMENT / TESTS ONLY ══════════════
# Separate database for the automated integration tests. WARNING: tests EMPTY this database.
TEST_DATABASE_URL="postgresql://tafaqqah:change-me-local-only@localhost:5432/tafaqqah_test"
# NEXT_DIST_DIR=".next-alt"       # run a second dev server beside the main one
